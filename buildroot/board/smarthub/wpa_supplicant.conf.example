# Template for the board's Wi-Fi credentials.
#
# Optional. An image without this can join Wi-Fi from its touch screen, under Settings, Network.
# To build the credentials into an image instead, copy this to
# overlay/etc/wpa_supplicant/wpa_supplicant.conf (git-ignored) and fill in your network.
ctrl_interface=/var/run/wpa_supplicant
ctrl_interface_group=0
update_config=1
country=US

network={
    ssid="YOUR_SSID"
    psk="YOUR_PASSPHRASE"
    key_mgmt=WPA-PSK
}
