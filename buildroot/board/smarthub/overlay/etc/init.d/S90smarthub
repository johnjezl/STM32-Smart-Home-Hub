#!/bin/sh
#
# Start the SmartHub application, which logs to syslog
#

SUPERVISOR="${SMARTHUB_SUPERVISOR:-/usr/libexec/smarthub-supervise}"
PIDFILE="${SMARTHUB_PIDFILE:-/var/run/smarthub.pid}"

running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

wait_for_exit() {
    i=0
    while running && [ "$i" -lt "$1" ]; do
        sleep 1
        i=$((i + 1))
    done
    ! running
}

start() {
    printf "Starting smarthub: "
    if running; then
        echo "already running"
        return 0
    fi
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$SUPERVISOR"
    sleep 1
    if running; then
        echo "OK"
    else
        echo "FAIL"
        return 1
    fi
}

stop() {
    printf "Stopping smarthub: "
    if ! running; then
        rm -f "$PIDFILE"
        echo "not running"
        return 0
    fi

    # It saves its state on the way out, so give it time. A second TERM makes it give up on that,
    # 5 seconds after the first at the soonest.
    kill -TERM "$(cat "$PIDFILE")"
    wait_for_exit 15 || {
        kill -TERM "$(cat "$PIDFILE")"
        wait_for_exit 8
    } || {
        pkill -KILL -P "$(cat "$PIDFILE")"
        kill -KILL "$(cat "$PIDFILE")"
        wait_for_exit 3
    }

    if running; then
        echo "FAIL"
        return 1
    fi
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
