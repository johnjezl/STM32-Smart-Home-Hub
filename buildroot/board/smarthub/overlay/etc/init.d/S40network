#!/bin/sh
#
# Start networking
#

case "$1" in
  start)
    echo "Starting network..."

    # Bring up loopback
    ip link set lo up

    # Bring up ethernet
    ip link set eth0 up

    # Start DHCP on ethernet
    if [ -x /usr/sbin/dhcpcd ]; then
        dhcpcd -b eth0
    elif [ -x /sbin/udhcpc ]; then
        udhcpc -i eth0 -b -q
    fi

    # Start WiFi even with no networks yet, as the touch screen's Wi-Fi setup needs it running
    # to scan and connect, and saves what it connects to here. S41dhcpcd gets it an address.
    WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf
    mkdir -p "$(dirname "$WPA_CONF")"
    touch "$WPA_CONF"
    # Without these, an empty or hand-written file couldn't be used by the screen or saved to
    for setting in update_config=1 ctrl_interface=/var/run/wpa_supplicant; do
        if ! grep -q "^${setting%%=*}=" "$WPA_CONF"; then
            (umask 077; { echo "$setting"; cat "$WPA_CONF"; } > "$WPA_CONF.new" && mv "$WPA_CONF.new" "$WPA_CONF")
        fi
    done
    # It holds the Wi-Fi password
    chmod 600 "$WPA_CONF"

    # The driver is a module, and its firmware can take a moment to load
    i=0
    while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done

    echo "Starting WiFi..."
    ip link set wlan0 up
    # Saving replaces the file with a new one, which gets this umask
    if ! (umask 077; wpa_supplicant -B -i wlan0 -c "$WPA_CONF"); then
        echo "Failed to start wpa_supplicant"
    fi
    ;;
  stop)
    echo "Stopping network..."
    killall wpa_supplicant 2>/dev/null
    killall dhcpcd 2>/dev/null
    killall udhcpc 2>/dev/null
    ip link set wlan0 down 2>/dev/null
    ip link set eth0 down
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
